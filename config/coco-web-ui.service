[Unit]
Description=Common Compute OS Web UI (nextjs-ollama-llm-ui)
After=network.target ollama.service
Wants=ollama.service
StartLimitIntervalSec=500
StartLimitBurst=5

[Service]
Type=simple
User=__INSTALL_USER__
Group=__INSTALL_USER__
Restart=on-failure
RestartSec=5s
WorkingDirectory=/opt/coco-web-ui
Environment=NODE_ENV=production
Environment=PORT=3000
Environment=NEXT_PUBLIC_OLLAMA_URL=http://localhost:11434
ExecStart=/usr/bin/npx next start -p 3000
KillMode=mixed
KillSignal=SIGINT
TimeoutStopSec=5

# Logging
StandardOutput=journal
StandardError=journal
SyslogIdentifier=coco-web-ui

[Install]
WantedBy=multi-user.target
